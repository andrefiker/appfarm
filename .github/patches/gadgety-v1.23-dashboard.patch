+@Composable
+private fun DashboardHome(month: YearMonth, snapshot: DashboardSnapshot,
+    incomes: List<PatientRow>, expenses: List<ExpenseRow>, scroll: LazyListState, ready: Boolean,
+    onPrevious: () -> Unit, onNext: () -> Unit,
+    onIncomePending: () -> Unit, onExpensePending: () -> Unit,
+    onAllExpenses: () -> Unit, onExpense: (ExpenseRow) -> Unit
+) {
+    val pendingIncome = incomes.filterNot { it.line.full }
+    val pendingExpense = expenses.filterNot { it.line.full }
+    val featured = expenses.sortedWith(compareByDescending<ExpenseRow> {
+        // Pressure over budget takes precedence, then real spending and monthly size.
+        if (it.payment.expectedCents > 0 && it.payment.paidCents > it.payment.expectedCents) 1 else 0
+    }.thenByDescending { it.payment.paidCents }.thenByDescending { it.payment.expectedCents }).take(6)
+    LazyColumn(Modifier.fillMaxSize().statusBarsPadding(), state = scroll) {
+        item("month") { MonthSelector(month, onPrevious, onNext) }
+        item("balance") { AvailableRing(snapshot) }
+        item("plan") { PlannedSummary(snapshot) }
+        item("pending") {
+            Text("PENDÊNCIAS", Modifier.padding(start = 20.dp, top = 19.dp, bottom = 4.dp),
+                color = muted, fontSize = 11.sp, fontWeight = FontWeight.Bold)
+            if (pendingIncome.isEmpty() && pendingExpense.isEmpty()) {
+                Text(if (ready) "✓ Tudo em dia" else "Carregando receitas…",
+                    Modifier.padding(horizontal = 20.dp, vertical = 10.dp), color = teal, fontSize = 14.sp)
+            } else {
+                if (pendingIncome.isNotEmpty()) PendingLine("Receitas", pendingIncome.size,
+                    pendingCents(pendingIncome.map { it.line }), onIncomePending)
+                if (pendingExpense.isNotEmpty()) PendingLine("Gastos", pendingExpense.size,
+                    pendingCents(pendingExpense.map { it.line }), onExpensePending)
+            }
+        }
+        item("expenses-heading") {
+            Row(Modifier.fillMaxWidth().padding(start = 20.dp, end = 20.dp, top = 24.dp, bottom = 7.dp),
+                verticalAlignment = Alignment.CenterVertically) {
+                Text("ONDE ESTOU GASTANDO", Modifier.weight(1f), color = navy,
+                    fontSize = 12.sp, fontWeight = FontWeight.Bold)
+                Text("Ver todos  →", Modifier.clickable(onClick = onAllExpenses).padding(6.dp),
+                    color = teal, fontSize = 12.sp)
+            }
+        }
+        if (featured.isEmpty()) item("empty") {
+            Text("Nenhum gasto neste mês.", Modifier.padding(horizontal = 20.dp, vertical = 12.dp),
+                color = muted, fontSize = 13.sp)
+        }
+        items(featured, key = { it.expense.id }) { row -> ExpenseProgressLine(row) { onExpense(row) } }
+        item("end") { Spacer(Modifier.height(22.dp)) }
+    }
+}
+
+@Composable
+private fun AvailableRing(snapshot: DashboardSnapshot) {
+    val ratio = snapshot.usage
+    val progress = ratio?.coerceIn(0f, 1f) ?: 0f
+    Box(Modifier.fillMaxWidth().height(190.dp), contentAlignment = Alignment.Center) {
+        Canvas(Modifier.size(166.dp).semantics {
+            contentDescription = if (ratio == null) "Sem recebimentos para calcular o uso"
+                else "${(ratio * 100).toInt()} por cento do recebido gasto"
+        }) {
+            val stroke = Stroke(width = 12.dp.toPx(), cap = StrokeCap.Round)
+            drawArc(accent, -90f, 360f, false, style = stroke)
+            if (ratio != null) drawArc(if (ratio > 1f) Color(0xFFAD6260) else teal,
+                -90f, 360f * progress, false, style = stroke)
+        }
+        Column(horizontalAlignment = Alignment.CenterHorizontally) {
+            Text(ledgerMoney(snapshot.availableNow), color = if (snapshot.availableNow < 0) Color(0xFFAD6260) else navy,
+                fontSize = 27.sp, fontWeight = FontWeight.Bold, maxLines = 1)
+            Text("DISPONÍVEL AGORA", color = muted, fontSize = 10.sp, fontWeight = FontWeight.Bold,
+                letterSpacing = 1.sp)
+            Text(if (ratio == null) "Sem recebimentos" else "${(ratio * 100).toInt()}% do recebido gasto",
+                color = muted, fontSize = 10.sp)
+        }
+    }
+}
+
+@Composable
+private fun PlannedSummary(snapshot: DashboardSnapshot) {
+    Column(Modifier.fillMaxWidth().padding(horizontal = 20.dp)) {
+        HorizontalDivider(color = divider)
+        Text("PREVISTO NO MÊS", Modifier.padding(top = 10.dp, bottom = 4.dp), color = muted,
+            fontSize = 10.sp, fontWeight = FontWeight.Bold, letterSpacing = 0.8.sp)
+        MoneyPair("Receitas", snapshot.expectedIncome)
+        MoneyPair("Gastos", snapshot.expectedExpense)
+        MoneyPair("Sobra prevista", snapshot.plannedSurplus, true)
+        HorizontalDivider(Modifier.padding(top = 8.dp), color = divider)
+    }
+}
+
+@Composable
+private fun MoneyPair(label: String, cents: Long, strong: Boolean = false) {
+    Row(Modifier.fillMaxWidth().height(28.dp), verticalAlignment = Alignment.CenterVertically) {
+        Text(label, Modifier.weight(1f), color = if (strong) navy else muted,
+            fontSize = 13.sp, fontWeight = if (strong) FontWeight.SemiBold else FontWeight.Normal)
+        Text(ledgerMoney(cents), color = if (cents < 0) Color(0xFFAD6260) else navy,
+            fontSize = 14.sp, fontWeight = if (strong) FontWeight.Bold else FontWeight.Medium)
+    }
+}
+
+@Composable
+private fun PendingLine(label: String, count: Int, cents: Long, action: () -> Unit) {
+    Row(Modifier.fillMaxWidth().height(43.dp).clickable(onClick = action)
+        .padding(horizontal = 20.dp), verticalAlignment = Alignment.CenterVertically) {
+        Text(label, Modifier.weight(1f), color = navy, fontSize = 14.sp)
+        Text("$count · ${ledgerMoney(cents)}  ›", color = teal, fontSize = 13.sp,
+            fontWeight = FontWeight.SemiBold)
+    }
+}
+
+@Composable
+private fun ExpenseProgressLine(row: ExpenseRow, action: () -> Unit) {
+    val planned = row.payment.expectedCents
+    val paid = row.payment.paidCents
+    val ratio = if (planned > 0) paid.toFloat() / planned else null
+    val bar = if (ratio == null) muted else when {
+        ratio > 1f -> Color(0xFFAD6260)
+        ratio >= 0.8f -> Color(0xFFB28353)
+        else -> teal
+    }
+    Column(Modifier.fillMaxWidth().clickable(onClick = action)
+        .padding(horizontal = 20.dp, vertical = 9.dp)) {
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            Text(row.expense.name, Modifier.weight(1f), color = navy, fontSize = 14.sp,
+                fontWeight = FontWeight.SemiBold, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            Text("${ledgerMoney(paid)} de ${ledgerMoney(planned)}", color = muted, fontSize = 12.sp,
+                maxLines = 1)
+        }
+        Spacer(Modifier.height(8.dp))
+        Box(Modifier.fillMaxWidth().height(4.dp).background(accent, RoundedCornerShape(2.dp))) {
+            val progress = ratio?.coerceIn(0f, 1f) ?: 0f
+            if (progress > 0f) Box(Modifier.fillMaxWidth(progress).height(4.dp)
+                .background(bar, RoundedCornerShape(2.dp)))
+        }
+    }
+    HorizontalDivider(Modifier.padding(horizontal = 20.dp), color = divider)
+}
