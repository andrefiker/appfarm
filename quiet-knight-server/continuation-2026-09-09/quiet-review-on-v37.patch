+export function QuietReview({record,onStatus}:{record:GameRecord;onStatus?:(status:string)=>void}){const[result,setResult]=useState<Review|null>(null);const[status,setStatus]=useState('');const[busy,setBusy]=useState(false);const controller=useRef<AbortController|null>(null);useEffect(()=>()=>controller.current?.abort(),[]);function report(text:string){setStatus(text);onStatus?.(text);}async function review(){if(busy)return;if(!navigator.onLine){report('Quiet Review needs internet. Your game stays saved.');return;}let input;try{input=reviewInput(record);}catch(e){report((e as Error).message);return;}setBusy(true);report('Looking back with Stockfish…');const request=new AbortController();controller.current=request;const timer=window.setTimeout(()=>request.abort(),8000);try{const response=await fetch(MULTIPLAYER_BASE+'/computer/review',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(input),cache:'no-store',signal:request.signal});const data=await response.json();if(!response.ok)throw Error(typeof data.error==='string'?data.error:'Quiet Review is unavailable. Try again later.');if(!Array.isArray(data.moments)||data.moments.length>3)throw Error('Review unavailable.');setResult(data);report(data.cached?'Saved review':'Review ready');}catch(e){if(controller.current===request)report(request.signal.aborted?'Review stopped. You can try again.':(e as Error).message);}finally{window.clearTimeout(timer);if(controller.current===request){controller.current=null;setBusy(false);}}}return <section className='quiet-review post-game-tools'><details><summary>Quiet Review</summary>{!result?<><p>Three moments worth remembering. A brief Stockfish review, after the game.</p><button type='button' className='secondary' disabled={busy} onClick={()=>void review()}>{busy?'Reviewing…':'Review three moments'}</button>{busy?<button type='button' className='copy-invite-link' onClick={()=>controller.current?.abort()}>Cancel review</button>:null}</>:<><p>{result.moments.length?result.message:"A steady game. No single move decided it."}</p>{result.moments.map(moment=><article key={moment.type}><h3>{labels[moment.type]}</h3><p>{moment.move_number}{moment.color==='b'?'…':'.'}{moment.played_san}{moment.type==='turning_point'?' changed the shape of the game.':moment.type==='best_moment'?' was a moment to keep.':moment.suggested_move?` · ${moment.suggested_move.san} was a stronger continuation.`:' offered another possibility.'}</p></article>)}<small>{result.engine} · Brief review, not exhaustive analysis.</small></>}{status?<p role='status'>{status}</p>:null}</details></section>;}
