+import {useEffect,useRef,useState} from 'react';import {Chess} from 'chess.js';import {MULTIPLAYER_BASE} from './network';import type {GameRecord} from './game-record';
+type Moment={type:'turning_point'|'missed_chance'|'best_moment';ply:number;move_number:number;color:'w'|'b';played_san:string;suggested_move?:{san:string};fen_before:string;fen_after:string};type Review={engine:string;moments:Moment[];message:string;cached?:boolean};
+export function reviewInput(record:GameRecord){if(record.result==='*')throw Error('Finish the game before reviewing.');const game=new Chess();const moves=record.sans.map(san=>{const m=game.move(san);return{from:m.from,to:m.to,promotion:m.promotion};});if(game.fen()!==record.fen)throw Error('The saved history does not match this position.');if(moves.length<2||moves.length>160)throw Error('Quiet Review supports games of 1–80 full moves.');if(record.ledgerId)return{game_id:record.ledgerId};if(!game.isGameOver())throw Error('A saved multiplayer result is needed to review a resignation.');return{moves,final_fen:record.fen};}
