<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:fillViewport="true" android:background="@color/away_deep" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="AWAY" android:textColor="@color/away_muted" android:textSize="14sp" android:letterSpacing="0.18" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/main_duration" android:text="—" android:textColor="@color/away_cream" android:textSize="58sp" android:fontFamily="sans" android:includeFontPadding="false" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/main_message" android:text="You gave yourself some space." android:textColor="@color/away_muted" android:textSize="17sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/today_heading" android:textColor="@color/away_muted" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <TextView android:id="@+id/longest_value" android:text="—" android:textColor="@color/away_cream" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/permission_status" android:textColor="@color/away_muted" android:textSize="14sp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/permission_explanation" android:textColor="@color/away_muted" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/permission_button" android:text="@string/permission_button" android:textColor="@color/away_deep" android:backgroundTint="@color/away_cream" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="56dp" />
        <Button android:id="@+id/refresh_button" android:text="@string/refresh_button" android:textColor="@color/away_cream" android:backgroundTint="@color/away_green" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="52dp" />
        <CheckBox android:id="@+id/notification_toggle" android:text="@string/notifications_toggle" android:textColor="@color/away_cream" android:buttonTint="@color/away_cream" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/minimum_duration" android:textColor="@color/away_muted" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <NumberPicker android:id="@+id/minimum_minutes" android:layout_width="80dp" android:layout_height="100dp" />
        </LinearLayout>
        <TextView android:text="@string/widget_instructions" android:textColor="@color/away_muted" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
