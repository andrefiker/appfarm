+@Composable
+private fun LedgerHeader(title: String, add: () -> Unit, searching: Boolean, toggleSearch: () -> Unit) {
+    Row(Modifier.fillMaxWidth().height(54.dp).padding(horizontal = 18.dp),
+        verticalAlignment = Alignment.CenterVertically) {
+        Text(title, Modifier.weight(1f), color = navy, fontSize = 15.sp, fontWeight = FontWeight.Bold,
+            letterSpacing = 1.sp)
+        Text(if (searching) "Fechar" else "⌕", Modifier.clickable(onClick = toggleSearch)
+            .semantics { contentDescription = if (searching) "Fechar busca" else "Buscar" }
+            .padding(horizontal = 12.dp, vertical = 10.dp), color = teal, fontSize = 19.sp)
+        Text("+ Adicionar", Modifier.clickable(onClick = add).padding(vertical = 11.dp),
+            color = teal, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+    }
+}
+
+@Composable
+private fun LedgerTotals(first: String, expected: Long, second: String, actual: Long,
+    third: String, remainder: Long) {
+    Column(Modifier.fillMaxWidth().padding(horizontal = 20.dp)) {
+        MoneyPair(first, expected)
+        MoneyPair(second, actual)
+        MoneyPair(third, remainder, true)
+        HorizontalDivider(Modifier.padding(top = 8.dp), color = divider)
+    }
+}
+
+@Composable
+private fun FilterAndSearch(pending: Boolean, togglePending: () -> Unit,
+    searching: Boolean, query: String, updateQuery: (String) -> Unit) {
+    Column(Modifier.fillMaxWidth().padding(horizontal = 18.dp)) {
+        Row(Modifier.fillMaxWidth().height(45.dp), verticalAlignment = Alignment.CenterVertically) {
+            Text(if (pending) "● Só pendentes" else "○ Só pendentes",
+                Modifier.clickable(onClick = togglePending).padding(vertical = 10.dp),
+                color = teal, fontSize = 12.sp)
+        }
+        if (searching) OutlinedTextField(query, updateQuery, Modifier.fillMaxWidth(),
+            label = { Text("Buscar") }, singleLine = true)
+    }
+}
+
+@Composable
+private fun ArchivedHeading() {
+    Text("ARQUIVADOS", Modifier.padding(start = 18.dp, top = 20.dp, bottom = 6.dp),
+        color = muted, fontSize = 11.sp, fontWeight = FontWeight.Bold)
+}
+
+@Composable
+private fun ArchivedLine(name: String, edit: () -> Unit) {
+    Row(Modifier.fillMaxWidth().height(49.dp).clickable(onClick = edit)
+        .padding(horizontal = 18.dp), verticalAlignment = Alignment.CenterVertically) {
+        Text(name, Modifier.weight(1f), color = muted, fontSize = 13.sp,
+            maxLines = 1, overflow = TextOverflow.Ellipsis)
+        Text("Editar ›", color = teal, fontSize = 12.sp)
+    }
+    HorizontalDivider(color = divider)
+}
+
+@Composable
+private fun DashboardMore(onBackup: () -> Unit, onPrivateIncome: () -> Unit,
+    open: (String) -> Unit) {
+    LazyColumn(Modifier.fillMaxSize().statusBarsPadding().padding(horizontal = 20.dp)) {
+        item { Text("MAIS", Modifier.padding(top = 19.dp, bottom = 22.dp), color = navy,
+            fontSize = 17.sp, fontWeight = FontWeight.Bold, letterSpacing = 1.sp) }
+        item { MoreGroup("DADOS") }
+        item { MoreAction("Backup, importar e exportar", onBackup) }
+        item { MoreAction("Importar lista privada de receitas", onPrivateIncome) }
+        item { MoreGroup("ORGANIZAÇÃO") }
+        item { MoreAction("Categorias e regras", { open("RULES") }) }
+        item { MoreAction("Histórico e fechamento", { open("SUMMARY") }) }
+        item { MoreGroup("COMPORTAMENTO") }
+        item { MoreAction("Fricção", { open("FRICTION") }) }
+        item { MoreGroup("FERRAMENTAS") }
+        item { MoreAction("Extratos", { open("STATEMENTS") }) }
+        item { MoreGroup("APP") }
+        item { MoreAction("Configurações", { open("SETTINGS") }) }
+        item { MoreAction("Sobre", { open("ABOUT") }) }
+    }
+}
+
+@Composable
+private fun SettingsContent(onBackup: () -> Unit, onBudget: () -> Unit, onAbout: () -> Unit) {
+    Column(Modifier.fillMaxWidth().padding(horizontal = 20.dp)) {
+        Text("CONFIGURAÇÕES", Modifier.padding(vertical = 18.dp), color = navy,
+            fontSize = 17.sp, fontWeight = FontWeight.Bold)
+        MoreAction("Orçamento e fechamento", onBudget)
+        MoreAction("Backup e dados locais", onBackup)
+        MoreAction("Sobre Gadgety", onAbout)
+    }
+}
+
+@Composable
+private fun MoreGroup(title: String) {
+    Text(title, Modifier.padding(top = 12.dp, bottom = 4.dp), color = muted,
+        fontSize = 10.sp, fontWeight = FontWeight.Bold, letterSpacing = 0.8.sp)
+}
+
+@Composable
+private fun MoreAction(title: String, action: () -> Unit) {
+    Row(Modifier.fillMaxWidth().height(51.dp).clickable(onClick = action),
+        verticalAlignment = Alignment.CenterVertically) {
+        Text(title, Modifier.weight(1f), color = navy, fontSize = 14.sp)
+        Text("›", color = teal, fontSize = 20.sp)
+    }
+    HorizontalDivider(color = divider)
+}
+
+@Composable
+private fun DashboardNavigation(selected: DashboardTab, choose: (DashboardTab) -> Unit) {
+    Row(Modifier.fillMaxWidth().background(paper).navigationBarsPadding().height(62.dp),
+        horizontalArrangement = Arrangement.SpaceEvenly) {
+        DashboardTab.entries.forEach { tab ->
+            val active = selected == tab
+            Column(Modifier.weight(1f).fillMaxSize().clickable { choose(tab) }
+                .semantics { contentDescription = tab.label },
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.Center) {
+                Text(tab.icon, color = if (active) teal else muted, fontSize = 18.sp)
+                Text(tab.label, color = if (active) teal else muted, fontSize = 10.sp,
+                    fontWeight = if (active) FontWeight.Bold else FontWeight.Normal)
+            }
+        }
+    }
+}
