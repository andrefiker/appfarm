+@Composable
+private fun MonthSelector(month: YearMonth, previous: () -> Unit, next: () -> Unit) {
+    Row(Modifier.fillMaxWidth().height(56.dp).padding(horizontal = 17.dp),
+        verticalAlignment = Alignment.CenterVertically) {
+        Text("‹", Modifier.size(46.dp).clickable(onClick = previous)
+            .semantics { contentDescription = "Mês anterior" }, color = teal, fontSize = 30.sp,
+            textAlign = TextAlign.Center)
+        Text(month.format(dateFormatter).replaceFirstChar { it.titlecase(Locale("pt", "BR")) },
+            Modifier.weight(1f), color = navy, fontSize = 20.sp, fontWeight = FontWeight.SemiBold,
+            textAlign = TextAlign.Center, maxLines = 1)
+        Text("›", Modifier.size(46.dp).clickable(onClick = next)
+            .semantics { contentDescription = "Próximo mês" }, color = teal, fontSize = 30.sp,
+            textAlign = TextAlign.Center)
+    }
+}
