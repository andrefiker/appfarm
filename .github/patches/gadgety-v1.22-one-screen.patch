+internal data class LedgerOverview(
+    val expectedIncome: Long, val expectedExpense: Long,
+    val received: Long, val paid: Long
+) {
+    val plannedBalance get() = expectedIncome - expectedExpense
+    val available get() = received - paid
+}
+
+private enum class Overlay { NONE, STATEMENTS, SEARCH, MORE }
+private enum class AddKind { INCOME, EXPENSE }
+private sealed interface SelectedRow {
+    data class Income(val row: PatientRow) : SelectedRow
+    data class Expense(val row: ExpenseRow) : SelectedRow
+}
+
+@Composable
+internal fun OneMonthScreen(
+    income: ScreenState, patients: PatientPaymentsViewModel, ready: Boolean,
+    expenses: ExpensesState, spending: ExpensesViewModel,
+    statements: StatementInboxState, inbox: StatementInboxViewModel,
+    onBackup: () -> Unit, onPrivateIncome: () -> Unit
+) {
+    var overlay by rememberSaveable { mutableStateOf(Overlay.NONE) }
+    var morePage by rememberSaveable { mutableStateOf("ROOT") }
+    var chosenStatementId by rememberSaveable { mutableStateOf<String?>(null) }
+    var menuOpen by remember { mutableStateOf(false) }
+    var addKind by remember { mutableStateOf<AddKind?>(null) }
+    var selected by remember { mutableStateOf<SelectedRow?>(null) }
+    var incomeExpanded by rememberSaveable { mutableStateOf(false) }
+    var expenseExpanded by rememberSaveable { mutableStateOf(false) }
+    var query by rememberSaveable { mutableStateOf("") }
+    val scroll = rememberLazyListState()
+    val month = expenses.month
+    val activeIncome = income.rows.filter { it.payment.included }
+    val activeExpenses = expenses.rows.filter { it.payment.included }
+    val totals = LedgerOverview(income.totals.expected, expenses.totals.expected,
+        income.totals.paid, expenses.totals.paid)
+    val pendingIncome = activeIncome.filterNot { it.line.full }
+    val pendingExpenses = activeExpenses.filterNot { it.line.full }
+    val pendingStatements = statements.items.size
+    BackHandler(overlay != Overlay.NONE) { overlay = Overlay.NONE }
+
+    when (overlay) {
+        Overlay.STATEMENTS -> Column(Modifier.fillMaxSize().background(paper)) {
+            OverlayBack("Extratos") { overlay = Overlay.NONE }
+            Box(Modifier.weight(1f)) { StatementInboxScreen(statements, inbox, chosenStatementId) }
+        }
+        Overlay.MORE -> Column(Modifier.fillMaxSize().background(paper)) {
+            OverlayBack("Mais") { overlay = Overlay.NONE }
+            Box(Modifier.weight(1f)) {
+                MoreScreen(expenses, spending, income.totals, statements, inbox, onBackup, morePage)
+            }
+        }
+        Overlay.SEARCH -> SearchLedger(query, { query = it }, income, expenses, statements,
+            { overlay = Overlay.NONE }, { selected = SelectedRow.Income(it) },
+            { selected = SelectedRow.Expense(it) }, {
+                chosenStatementId = it.id; overlay = Overlay.STATEMENTS
+            })
+        Overlay.NONE -> MonthLedger(month.format(dateFormatter).replaceFirstChar {
+                it.titlecase(Locale("pt", "BR"))
+            }, totals, activeIncome, activeExpenses, pendingIncome, pendingExpenses,
+            pendingStatements, ready, spending, expenses, scroll,
+            incomeExpanded, { incomeExpanded = !incomeExpanded },
+            expenseExpanded, { expenseExpanded = !expenseExpanded },
+            onPrevious = { patients.shiftMonth(-1); spending.shiftMonth(-1) },
+            onNext = { patients.shiftMonth(1); spending.shiftMonth(1) },
+            onAddIncome = { addKind = AddKind.INCOME; incomeExpanded = true },
+            onAddExpense = { addKind = AddKind.EXPENSE; expenseExpanded = true },
+            onStatements = { chosenStatementId = null; overlay = Overlay.STATEMENTS },
+            onSearch = { query = ""; overlay = Overlay.SEARCH },
+            onMenu = { menuOpen = true },
+            onIncome = { selected = SelectedRow.Income(it) },
+            onExpense = { selected = SelectedRow.Expense(it) },
+            onIncomeStatus = { row -> patients.setFull(row, !row.line.full) },
+            onExpenseStatus = { row -> spending.setFull(row, !row.line.full) },
+            onIncomePaid = { row -> selected = SelectedRow.Income(row) },
+            onExpensePaid = { row -> selected = SelectedRow.Expense(row) })
+    }
+    if (menuOpen) ModalBottomSheet(onDismissRequest = { menuOpen = false }) {
+        Column(Modifier.navigationBarsPadding().padding(horizontal = 20.dp)) {
+            MenuLine("Histórico e fechamento") { menuOpen = false; morePage = "SUMMARY"; overlay = Overlay.MORE }
+            MenuLine("Regras de comerciantes e categorias") { menuOpen = false; morePage = "RULES"; overlay = Overlay.MORE }
+            MenuLine("Fricção") { menuOpen = false; morePage = "FRICTION"; overlay = Overlay.MORE }
+            MenuLine("Backup, importar e exportar") { menuOpen = false; onBackup() }
+            MenuLine("Importar lista privada de receitas") { menuOpen = false; onPrivateIncome() }
+            MenuLine("Configurações e sobre") { menuOpen = false; morePage = "ROOT"; overlay = Overlay.MORE }
+            Spacer(Modifier.height(12.dp))
+        }
+    }
+    when (val kind = addKind) {
+        AddKind.INCOME -> AddLedgerSheet("Nova receita", "Nome ou apelido", { addKind = null }) { name, amount ->
+            patients.add(name, amount, true); addKind = null
+        }
+        AddKind.EXPENSE -> AddLedgerSheet("Novo gasto", "Nome do gasto", { addKind = null }) { name, amount ->
+            spending.add(name, amount, true); addKind = null
+        }
+        null -> Unit
+    }
+    when (val row = selected) {
+        is SelectedRow.Income -> IncomeEditorSheet(row.row, patients, { selected = null })
+        is SelectedRow.Expense -> ExpenseEditorSheet(row.row, spending, { selected = null })
+        null -> Unit
+    }
+}
