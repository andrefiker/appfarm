+        val september = YearMonth.of(2026, 9)
+        var db = open()
+        var dao = db.expenses()
+        val now = System.currentTimeMillis()
+        FixedMonthlyCategories.forMonth(september, now).forEach { expense ->
+            dao.createExpenseForMonth(expense, september)
+        }
+        assertEquals(1_380_000L, dao.months(september.key()).first().sumOf { it.expectedCents })
+
+        val added = Expense("synthetic-extra", "Synthetic expense", 20_000, true, null,
+            september.key(), now, now, category = "Synthetic", baselineCents = 20_000)
+        dao.createExpenseForMonth(added, september)
+        assertEquals(1_400_000L, dao.months(september.key()).first().sumOf { it.expectedCents })
+        dao.putMonth(dao.month(added.id, september.key())!!.copy(paidCents = 7_500))
+        dao.changeDefault(added.id, september, 30_000)
+        assertEquals(1_410_000L, dao.months(september.key()).first().sumOf { it.expectedCents })
+        assertEquals(7_500L, dao.month(added.id, september.key())!!.paidCents)
+
+        db.close()
+        db = open()
+        dao = db.expenses()
+        assertEquals(1_410_000L, dao.months(september.key()).first().sumOf { it.expectedCents })
+        assertEquals(7_500L, dao.month(added.id, september.key())!!.paidCents)
+        dao.delete(added.id)
+        assertEquals(1_380_000L, dao.months(september.key()).first().sumOf { it.expectedCents })
+        db.close()
+    }
