{
  "name": "quiet-knight-desktop",
  "version": "1.1.11",
  "description": "Quiet Knight desktop application",
  "author": "AppFarm",
  "private": true,
  "main": "main.cjs",
  "scripts": {"build:windows": "electron-builder --win nsis --x64"},
  "devDependencies": {"electron": "39.8.3", "electron-builder": "26.8.1"},
  "build": {
    "appId": "com.appfarm.quietknight.desktop",
    "productName": "Quiet Knight",
    "directories": {"output": "dist"},
    "files": ["main.cjs", "icon.png", "package.json"],
    "win": {"target": ["nsis"], "icon": "icon.png", "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true}
  }
}
