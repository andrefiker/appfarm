+    @Test fun addingPatientCreatesSelectedMonthAndUpdatesTotalsWithoutChangingPaid() = runBlocking {
+        context.deleteDatabase(fileName)
+        val september = YearMonth.of(2026, 9)
+        val october = september.plusMonths(1)
+        var db = Room.databaseBuilder(context, PaymentsDatabase::class.java, fileName).build()
+        var dao = db.dao()
+        val now = System.currentTimeMillis()
+        dao.createPatientForMonth(Patient("synthetic-1", owner, "Synthetic A", 90_000, true, null,
+            september.key(), now, now), september)
+        dao.createPatientForMonth(Patient("synthetic-2", owner, "Synthetic B", 90_000, true, null,
+            september.key(), now, now), september)
+        dao.putMonth(dao.month(owner, "synthetic-1", september.key())!!.copy(paidCents = 90_000))
+        dao.putMonth(dao.month(owner, "synthetic-2", september.key())!!.copy(paidCents = 90_000))
+
+        dao.createPatientForMonth(Patient("synthetic-3", owner, "Synthetic C", 50_000, true, null,
+            september.key(), now, now), september)
+
+        val septemberRows = dao.months(owner, september.key()).first()
+        val septemberTotals = PaymentRules.totals(septemberRows.map {
+            MonthLine(it.expectedCents, it.paidCents, it.included, it.forceIncomplete)
+        })
+        assertEquals(3, septemberRows.size)
+        assertEquals(230_000L, septemberTotals.expected)
+        assertEquals(180_000L, septemberTotals.paid)
+        assertEquals(50_000L, septemberTotals.remaining)
+        dao.ensureMonth(owner, september)
+        assertEquals(3, dao.months(owner, september.key()).first().size)
+
+        dao.createPatientForMonth(Patient("synthetic-october", owner, "Synthetic D", 40_000, true, null,
+            october.key(), now, now), october)
+        assertNotNull(dao.month(owner, "synthetic-october", october.key()))
+        assertNull(dao.month(owner, "synthetic-october", september.key()))
+        db.close()
+
+        db = Room.databaseBuilder(context, PaymentsDatabase::class.java, fileName).build()
+        dao = db.dao()
+        val reopened = dao.incomeMonthAggregate(owner, september.key())
+        assertEquals(3, reopened.patientCount)
+        assertEquals(230_000L, reopened.expectedTotalCents)
+        assertEquals(180_000L, reopened.paidTotalCents)
+        db.close()
+    }
