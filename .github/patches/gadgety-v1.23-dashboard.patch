+@Composable
+private fun IncomeLedger(state: ScreenState, active: List<PatientRow>, scroll: LazyListState,
+    pending: Boolean, togglePending: () -> Unit, searching: Boolean, toggleSearch: () -> Unit,
+    query: String, updateQuery: (String) -> Unit, previous: () -> Unit, next: () -> Unit,
+    add: () -> Unit, edit: (PatientRow) -> Unit, status: (PatientRow) -> Unit
+) {
+    val rows = active.filter { (!pending || !it.line.full) &&
+        (query.isBlank() || it.patient.name.contains(query, true)) }
+    val archived = if (pending) emptyList() else state.rows.filter { !it.payment.included &&
+        (query.isBlank() || it.patient.name.contains(query, true)) }
+    LazyColumn(Modifier.fillMaxSize().statusBarsPadding(), state = scroll) {
+        item("header") {
+            LedgerHeader("RECEITAS", add, searching, toggleSearch)
+            MonthSelector(state.month, previous, next)
+            LedgerTotals("Previsto", state.totals.expected, "Recebido", state.totals.paid,
+                "Pendente", pendingCents(active.map { it.line }))
+            FilterAndSearch(pending, togglePending, searching, query, updateQuery)
+        }
+        if (rows.isEmpty()) item("empty") {
+            Text(if (pending) "Nenhuma receita pendente." else "Nenhuma receita neste mês.",
+                Modifier.padding(20.dp), color = muted, fontSize = 14.sp)
+        }
+        items(rows, key = { it.patient.id }) { row ->
+            LedgerLine(row.patient.name, row.payment.expectedCents, row.payment.paidCents,
+                row.line.full, "Recebido", { edit(row) }, { edit(row) }, { status(row) })
+        }
+        if (archived.isNotEmpty()) item("archived-heading") { ArchivedHeading() }
+        items(archived, key = { "archived-${it.patient.id}" }) { row ->
+            ArchivedLine(row.patient.name) { edit(row) }
+        }
+        item("end") { Spacer(Modifier.height(20.dp)) }
+    }
+}
+
+@Composable
+private fun ExpenseLedger(state: ExpensesState, active: List<ExpenseRow>, scroll: LazyListState,
+    pending: Boolean, togglePending: () -> Unit, searching: Boolean, toggleSearch: () -> Unit,
+    query: String, updateQuery: (String) -> Unit, previous: () -> Unit, next: () -> Unit,
+    add: () -> Unit, edit: (ExpenseRow) -> Unit, status: (ExpenseRow) -> Unit
+) {
+    val rows = active.filter { (!pending || !it.line.full) &&
+        (query.isBlank() || it.expense.name.contains(query, true) || it.expense.category.contains(query, true)) }
+    val archived = if (pending) emptyList() else state.rows.filter { !it.payment.included &&
+        (query.isBlank() || it.expense.name.contains(query, true) || it.expense.category.contains(query, true)) }
+    LazyColumn(Modifier.fillMaxSize().statusBarsPadding(), state = scroll) {
+        item("header") {
+            LedgerHeader("GASTOS", add, searching, toggleSearch)
+            MonthSelector(state.month, previous, next)
+            LedgerTotals("Previsto", state.totals.expected, "Pago", state.totals.paid,
+                "Pendente", pendingCents(active.map { it.line }))
+            FilterAndSearch(pending, togglePending, searching, query, updateQuery)
+        }
+        if (rows.isEmpty()) item("empty") {
+            Text(if (pending) "Nenhum gasto pendente." else "Nenhum gasto neste mês.",
+                Modifier.padding(20.dp), color = muted, fontSize = 14.sp)
+        }
+        items(rows, key = { it.expense.id }) { row ->
+            LedgerLine(row.expense.name, row.payment.expectedCents, row.payment.paidCents,
+                row.line.full, "Pago", { edit(row) }, { edit(row) }, { status(row) })
+        }
+        if (archived.isNotEmpty()) item("archived-heading") { ArchivedHeading() }
+        items(archived, key = { "archived-${it.expense.id}" }) { row ->
+            ArchivedLine(row.expense.name) { edit(row) }
+        }
+        item("end") { Spacer(Modifier.height(20.dp)) }
+    }
+}
