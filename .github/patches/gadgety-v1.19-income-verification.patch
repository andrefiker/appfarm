 internal class IncomeImportException(val userMessage: String, cause: Throwable? = null) :
     IllegalArgumentException(userMessage, cause)
 
+internal fun verifyIncomeImport(
+    roster: IncomeRoster,
+    merge: IncomeRosterMergeResult,
+    stored: IncomeMonthAggregate
+): IncomeImportResult {
+    val expectedTotal = roster.entries.sumOf { it.monthlyCents }
+    val intendedPaidTotal = if (roster.markPaid) expectedTotal else 0L
+    if (stored.patientCount == 0) {
+        throw IncomeImportException("A lista foi lida, mas nenhum registro foi salvo.")
+    }
+    if (stored.patientCount != roster.entries.size) {
+        throw IncomeImportException(
+            "A lista contém ${roster.entries.size} registros, mas apenas ${stored.patientCount} foram encontrados após salvar."
+        )
+    }
+    if (stored.expectedTotalCents != expectedTotal || stored.paidTotalCents != intendedPaidTotal) {
+        throw IncomeImportException("Os valores salvos não correspondem ao arquivo importado.")
+    }
+    return IncomeImportResult(
+        month = roster.month,
+        rosterEntryCount = roster.entries.size,
+        insertedCount = merge.insertedCount,
+        updatedCount = merge.updatedCount,
+        databasePatientCountForMonth = stored.patientCount,
+        expectedTotalCents = stored.expectedTotalCents,
+        paidTotalCents = stored.paidTotalCents
+    )
+}
