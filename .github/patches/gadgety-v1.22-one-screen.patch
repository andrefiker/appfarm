+package com.andrefiker.lootpayments
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class OneMonthScreenTest {
+    @Test fun expectedAndActualRemainSeparate() {
+        val overview = LedgerOverview(
+            expectedIncome = 1_870_000, expectedExpense = 1_380_000,
+            received = 900_000, paid = 100_000
+        )
+        assertEquals(490_000, overview.plannedBalance)
+        assertEquals(800_000, overview.available)
+        assertEquals(1_380_000, overview.expectedExpense)
+        assertEquals(100_000, overview.paid)
+    }
+
+    @Test fun addingAnUnpaidIncomeChangesOnlyPlannedBalance() {
+        val before = LedgerOverview(1_780_000, 1_380_000, 1_780_000, 0)
+        val after = before.copy(expectedIncome = before.expectedIncome + 50_000)
+        assertEquals(450_000, after.plannedBalance)
+        assertEquals(before.available, after.available)
+    }
+
+    @Test fun recordingPaidExpenseChangesOnlyAvailable() {
+        val before = LedgerOverview(1_780_000, 1_380_000, 1_780_000, 0)
+        val after = before.copy(paid = 41_230)
+        assertEquals(before.plannedBalance, after.plannedBalance)
+        assertEquals(1_738_770, after.available)
+    }
+}
