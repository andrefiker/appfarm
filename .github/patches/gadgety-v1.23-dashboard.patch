@@ -0,0 +1,44 @@
+package com.andrefiker.lootpayments
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class DashboardSnapshotTest {
+    @Test fun availableUsesOnlyActualAndPlannedSurplusUsesOnlyExpected() {
+        val month = DashboardSnapshot(1_870_000, 1_000_000, 1_380_000, 358_000)
+        assertEquals(642_000, month.availableNow)
+        assertEquals(490_000, month.plannedSurplus)
+        assertEquals(0.358f, month.usage!!, 0.0001f)
+    }
+
+    @Test fun addingUnpaidIncomeOnlyChangesPlanUntilReceived() {
+        val before = DashboardSnapshot(1_780_000, 1_780_000, 1_380_000, 10_000)
+        val added = before.copy(expectedIncome = before.expectedIncome + 50_000)
+        assertEquals(450_000, added.plannedSurplus)
+        assertEquals(before.availableNow, added.availableNow)
+        assertEquals(before.availableNow + 50_000, added.copy(received = added.received + 50_000).availableNow)
+    }
+
+    @Test fun paidExpenseChangesAvailableWithoutChangingPlannedSurplus() {
+        val before = DashboardSnapshot(1_780_000, 1_780_000, 1_380_000, 0)
+        val paid = before.copy(paid = 41_230)
+        assertEquals(1_738_770, paid.availableNow)
+        assertEquals(before.plannedSurplus, paid.plannedSurplus)
+    }
+
+    @Test fun noReceivedIncomeHasNeutralProgress() {
+        assertNull(DashboardSnapshot(1_000_000, 0, 500_000, 20_000).usage)
+    }
+
+    @Test fun overpaymentDoesNotEraseAnotherRowsPendingAmount() {
+        assertEquals(50_000, pendingCents(listOf(
+            MonthLine(100_000, 120_000, true), MonthLine(80_000, 30_000, true),
+            MonthLine(50_000, 0, false))))
+    }
+
+    @Test fun oneTapStatusMovesActualBetweenPendingAndFull() {
+        assertEquals(50_000, toggledPaidCents(50_000, false))
+        assertEquals(0, toggledPaidCents(50_000, true))
+    }
+}
