+@Composable
+private fun SearchLedger(query: String, update: (String) -> Unit, income: ScreenState,
+    expenses: ExpensesState, statements: StatementInboxState, back: () -> Unit,
+    selectIncome: (PatientRow) -> Unit, selectExpense: (ExpenseRow) -> Unit,
+    openStatements: (StatementInboxItem) -> Unit) {
+    val patients = if (query.isBlank()) emptyList() else income.rows.filter {
+        it.patient.name.contains(query, ignoreCase = true)
+    }
+    val spending = if (query.isBlank()) emptyList() else expenses.rows.filter {
+        it.expense.name.contains(query, ignoreCase = true) ||
+            it.expense.category.contains(query, ignoreCase = true)
+    }
+    val inbox = if (query.isBlank()) emptyList() else statements.items.filter {
+        it.original.contains(query, ignoreCase = true) || it.correctedName.contains(query, ignoreCase = true)
+    }
+    Column(Modifier.fillMaxSize().background(paper)) {
+        OverlayBack("Buscar") { back() }
+        OutlinedTextField(query, update, Modifier.fillMaxWidth().padding(horizontal = 15.dp),
+            label = { Text("Pessoa, gasto ou extrato") }, singleLine = true)
+        LazyColumn(Modifier.fillMaxSize()) {
+            if (patients.isNotEmpty()) item { SearchHeading("RECEITAS") }
+            items(patients, key = { "s-p-${it.patient.id}" }) { row ->
+                SearchResult(row.patient.name, ledgerMoney(row.payment.expectedCents)) { selectIncome(row) }
+            }
+            if (spending.isNotEmpty()) item { SearchHeading("GASTOS") }
+            items(spending, key = { "s-e-${it.expense.id}" }) { row ->
+                SearchResult(row.expense.name, ledgerMoney(row.payment.expectedCents)) { selectExpense(row) }
+            }
+            if (inbox.isNotEmpty()) item { SearchHeading("EXTRATOS") }
+            items(inbox, key = { "s-i-${it.id}" }) { item ->
+                SearchResult(item.original, ledgerMoney(item.amountCents)) { openStatements(item) }
+            }
+        }
+    }
+}
