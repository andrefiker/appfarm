+internal data class DashboardSnapshot(
+    val expectedIncome: Long, val received: Long,
+    val expectedExpense: Long, val paid: Long
+) {
+    val availableNow get() = received - paid
+    val plannedSurplus get() = expectedIncome - expectedExpense
+    // A zero denominator is an empty state, never a percentage.
+    val usage: Float? get() = if (received > 0) (paid.toDouble() / received).toFloat() else null
+}
+
+internal fun pendingCents(lines: List<MonthLine>): Long = lines.filter { it.active }
+    .sumOf { (it.expected - it.paid).coerceAtLeast(0) }
+
+internal fun toggledPaidCents(expected: Long, full: Boolean): Long = if (full) 0 else expected
+
+private enum class DashboardTab(val label: String, val icon: String) {
+    DASHBOARD("Dashboard", "◉"), INCOME("Receitas", "↓"),
+    EXPENSE("Gastos", "↑"), MORE("Mais", "⋯")
+}
+
+@Composable
+internal fun DashboardApp(
+    income: ScreenState, patients: PatientPaymentsViewModel, ready: Boolean,
+    expenses: ExpensesState, spending: ExpensesViewModel,
+    statements: StatementInboxState, inbox: StatementInboxViewModel,
+    onBackup: () -> Unit, onPrivateIncome: () -> Unit, incomeImportSequence: Int
+) {
+    var tab by rememberSaveable { mutableStateOf(DashboardTab.DASHBOARD) }
+    var overlay by rememberSaveable { mutableStateOf("") }
+    var addKind by remember { mutableStateOf("") }
+    var selectedIncome by remember { mutableStateOf<PatientRow?>(null) }
+    var selectedExpense by remember { mutableStateOf<ExpenseRow?>(null) }
+    var incomePending by rememberSaveable { mutableStateOf(false) }
+    var expensePending by rememberSaveable { mutableStateOf(false) }
+    var incomeSearch by rememberSaveable { mutableStateOf(false) }
+    var expenseSearch by rememberSaveable { mutableStateOf(false) }
+    var incomeQuery by rememberSaveable { mutableStateOf("") }
+    var expenseQuery by rememberSaveable { mutableStateOf("") }
+    LaunchedEffect(incomeImportSequence) {
+        if (incomeImportSequence > 0) { overlay = ""; incomePending = false; tab = DashboardTab.INCOME }
+    }
+    val dashboardScroll = rememberLazyListState()
+    val incomeScroll = rememberLazyListState()
+    val expenseScroll = rememberLazyListState()
+    val snapshot = DashboardSnapshot(income.totals.expected, income.totals.paid,
+        expenses.totals.expected, expenses.totals.paid)
+    val incomes = income.rows.filter { it.payment.included }
+    val outgoings = expenses.rows.filter { it.payment.included }
+    fun shift(delta: Long) { patients.shiftMonth(delta); spending.shiftMonth(delta) }
+
+    BackHandler(overlay.isNotEmpty()) { overlay = "" }
+    if (overlay.isNotEmpty()) {
+        Column(Modifier.fillMaxSize().background(paper)) {
+            Row(Modifier.fillMaxWidth().statusBarsPadding().height(48.dp)
+                .clickable { overlay = "" }.padding(horizontal = 18.dp),
+                verticalAlignment = Alignment.CenterVertically) {
+                Text("‹  Voltar", color = teal, fontSize = 15.sp)
+            }
+            Box(Modifier.weight(1f)) {
+                when (overlay) {
+                    "STATEMENTS" -> StatementInboxScreen(statements, inbox)
+                    "SUMMARY", "RULES", "FRICTION" ->
+                        MoreScreen(expenses, spending, income.totals, statements, inbox, onBackup, overlay)
+                    "SETTINGS" -> SettingsContent(onBackup, { overlay = "SUMMARY" }, { overlay = "ABOUT" })
+                    "ABOUT" -> Column(Modifier.fillMaxWidth().padding(20.dp)) {
+                        Text("Gadgety", color = navy, fontSize = 22.sp, fontWeight = FontWeight.Bold)
+                        Text("Versão 1.23 · dados locais com backup criptografado",
+                            color = muted, fontSize = 13.sp)
+                    }
+                }
+            }
+        }
+    } else {
+        Column(Modifier.fillMaxSize().background(paper)) {
+            Box(Modifier.weight(1f)) {
+                when (tab) {
+                    DashboardTab.DASHBOARD -> DashboardHome(expenses.month, snapshot, incomes, outgoings,
+                        dashboardScroll, ready, onPrevious = { shift(-1) }, onNext = { shift(1) },
+                        onIncomePending = { incomePending = true; tab = DashboardTab.INCOME },
+                        onExpensePending = { expensePending = true; tab = DashboardTab.EXPENSE },
+                        onAllExpenses = { expensePending = false; tab = DashboardTab.EXPENSE },
+                        onExpense = { selectedExpense = it })
+                    DashboardTab.INCOME -> IncomeLedger(income, incomes, incomeScroll, incomePending,
+                        { incomePending = !incomePending }, incomeSearch, { incomeSearch = !incomeSearch; incomeQuery = "" },
+                        incomeQuery, { incomeQuery = it }, { shift(-1) }, { shift(1) },
+                        { addKind = "INCOME" }, { selectedIncome = it },
+                        { patients.setPaid(it, toggledPaidCents(it.payment.expectedCents, it.line.full)) })
+                    DashboardTab.EXPENSE -> ExpenseLedger(expenses, outgoings, expenseScroll, expensePending,
+                        { expensePending = !expensePending }, expenseSearch, { expenseSearch = !expenseSearch; expenseQuery = "" },
+                        expenseQuery, { expenseQuery = it }, { shift(-1) }, { shift(1) },
+                        { addKind = "EXPENSE" }, { selectedExpense = it },
+                        { spending.setPaid(it, toggledPaidCents(it.payment.expectedCents, it.line.full)) })
+                    DashboardTab.MORE -> DashboardMore(onBackup, onPrivateIncome, { overlay = it })
+                }
+            }
+            DashboardNavigation(tab) { destination ->
+                tab = destination
+                if (destination != DashboardTab.INCOME) incomePending = false
+                if (destination != DashboardTab.EXPENSE) expensePending = false
+            }
+        }
+    }
+    when (addKind) {
+        "INCOME" -> AddLedgerSheet("Nova receita", "Nome ou apelido", { addKind = "" }) { name, cents ->
+            patients.add(name, cents, true); incomePending = false; addKind = ""
+        }
+        "EXPENSE" -> AddLedgerSheet("Novo gasto", "Nome do gasto", { addKind = "" }) { name, cents ->
+            spending.add(name, cents, true); expensePending = false; addKind = ""
+        }
+    }
+    selectedIncome?.let { IncomeEditorSheet(it, patients) { selectedIncome = null } }
+    selectedExpense?.let { ExpenseEditorSheet(it, spending) { selectedExpense = null } }
+}
